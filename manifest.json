{
  "manifest_version": 3,
  "name": "Daybeam Calendar",
  "short_name": "Daybeam",
  "version": "1.3.0",
  "description": "A calm, quick way to check your Google Calendar and stay ahead of events.",
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "tts"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://openidconnect.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": "",
  "action": {
    "default_title": "Open Daybeam Calendar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "omnibox": {
    "keyword": "cal"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open Daybeam Calendar"
    }
  }
}
